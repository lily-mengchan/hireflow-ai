# Server-only configuration. Copy to .env.local and fill in credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHAT_MODEL=gpt-4o-mini
# Optional separate Embedding provider (falls back to OPENAI_* above).
# RAG_EMBEDDING_API_KEY=
# RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RAG_EMBEDDING_DIMENSIONS=1024
# Similarity is model-dependent; calibrate using npm run rag:verify.
RAG_MIN_SIMILARITY=0.25
